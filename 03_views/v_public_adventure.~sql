CREATE OR REPLACE VIEW v_public_adventure AS
SELECT
a.id AS adventure_id,
a.title,
a.difficulty,
a.total_distance,
a.average_rating,
u.username AS creator_username
FROM adventure a JOIN cityscape_user u
ON a.creator_id = u.id
WHERE a.status = 'PUBLIC'
GROUP BY 
a.id,
a.title,
a.difficulty,
a.total_distance,
a.average_rating,
u.username;
