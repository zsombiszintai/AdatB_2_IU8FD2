CREATE OR REPLACE PACKAGE BODY review_pkg IS

PROCEDURE add_review(p_user_id      NUMBER
                    ,p_adventure_id NUMBER
                    ,p_rating       NUMBER
                    ,p_review_text  VARCHAR2) IS

BEGIN
  INSERT INTO review
    (id
    ,user_id
    ,adventure_id
    ,rating
    ,review_text
    ,reviewed_at)
  VALUES
    (NULL
    ,p_user_id
    ,p_adventure_id
    ,p_rating
    ,p_review_text
    ,SYSDATE);

END add_review;

PROCEDURE update_review(p_review_id   NUMBER
                       ,p_rating      NUMBER
                       ,p_review_text VARCHAR2) IS

BEGIN
  UPDATE review
     SET rating      = p_rating
        ,review_text = p_review_text
        ,reviewed_at = SYSDATE
   WHERE id = p_review_id;

END update_review;
